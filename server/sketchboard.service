[Unit]
Description=Sketchboard harness (FastAPI in front of Ollama)
After=network.target ollama.service
Wants=ollama.service

[Service]
User=ubuntu
WorkingDirectory=/opt/sketchboard
EnvironmentFile=/opt/sketchboard/.env
ExecStart=/opt/sketchboard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --timeout-keep-alive 75
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
