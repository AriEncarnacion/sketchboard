// Copy to Secrets.xcconfig (git-ignored) and fill in. Both values come from
// `lambda/lambdactl.sh wait`. The IP changes on every launch of the box.
//
// xcconfig treats "//" as a comment, so the URL is written with $() to break it up.
// The Settings sheet in the app can override these without a rebuild.

GEMMA_BASE_URL = http:/$()/1.2.3.4:8080
GEMMA_TOKEN = paste-token-here

// Your Apple Personal Team id, so device signing survives `xcodegen generate`.
// Find it with: security find-identity -v -p codesigning  (the id in parentheses)
DEVELOPMENT_TEAM = XXXXXXXXXX

// Per-developer bundle id suffix; Personal Teams can't share one App ID.
BUNDLE_ID_SUFFIX = .yourname
