# Copy to lambda/.env (git-ignored) and fill in. Never commit the real file.

# From https://cloud.lambda.ai/api-keys
LAMBDA_API_KEY=

# Name the SSH key will have in Lambda Cloud, and the local public key to upload.
LAMBDA_SSH_KEY_NAME=sketchboard
LAMBDA_SSH_KEY_FILE=$HOME/.ssh/sketchboard_lambda.pub

# Shared secret the iPad app sends as "Authorization: Bearer ...".
# Leave empty and `lambdactl.sh launch` will generate one and write it here.
GEMMA_TOKEN=

# Nango (nango.dev) secret key for "Sign in with GitHub". Dashboard -> Environment settings.
# Optional: leave empty and the auth endpoints return 503; everything else still works.
NANGO_SECRET_KEY=
# The integration's unique key in the Nango dashboard (Integrations tab). Nango's template
# is "github-getting-started"; Ari's setup notes create one called "github".
NANGO_INTEGRATION_ID=github

# Ollama model tag to pull. Pick a smaller tag if the GPU has < 40 GB.
# gemma4:26b (MoE, ~4x faster, default), gemma4:31b (dense, 20 GB), gemma4:12b (7.6 GB)
OLLAMA_MODEL=gemma4:26b

# Instance types to try, in order. First one with capacity wins.
LAMBDA_INSTANCE_PREFS=gpu_1x_h100_sxm5,gpu_1x_h100_pcie,gpu_1x_a100_sxm4,gpu_1x_a100,gpu_1x_a6000,gpu_1x_a10

# Optional: pin a region (e.g. us-west-1). Empty = any region with capacity.
LAMBDA_REGION=

# When several regions have capacity, prefer these (in order). Others are fallbacks.
LAMBDA_REGION_PREFS=us-west-1,us-west-2,us-west-3,us-east-1,us-east-2,us-east-3,us-midwest-1,us-south-1,us-south-2,us-south-3,us-southeast-1

# Slack bot (slack/README.md). App-level token needs connections:write; bot token from Install App.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 1 = only react to images when @Sketchboard is mentioned
SLACK_REQUIRE_MENTION=0
